#!/bin/bash

export PATH="/home/imn/spack/opt/spack/linux-zen3/openmpi-5.0.10-3f4jdslslmixzmdmm3gfzh3pholz5krq/bin:$PATH"
PONNI_HOME=`pwd | sed 's/\(.*\/ponni\).*/\1/'`
export KOKKOS_HOME=$PONNI_HOME/unit/externals/kokkos

export CC=gcc
export CXX=g++
export FC=gfortran

unset CXXFLAGS
unset FFLAGS
unset FCFLAGS

export PONNI_DEBUG=ON
export PONNI_CXX_FLAGS="-O0;-g"
export PONNI_LINK_FLAGS=""
export PONNI_F90_FLAGS="-O0;-g"
export PONNI_BACKEND="Kokkos_ENABLE_CUDA"
export PROJ_ARCH="Kokkos_ARCH_BLACKWELL120"
export PONNI_COVERAGE="ON"
