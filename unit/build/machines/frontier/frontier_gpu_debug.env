#!/bin/bash

$MODULESHOME/init/bash
module reset
module load PrgEnv-amd cray-hdf5 craype-accel-amd-gfx90a

export ROCM_PATH=${CRAY_AMD_COMPILER_PREFIX}
unset HSA_XNACK

export YAKL_HOME=/ccs/home/$USER/YAKL
PONNI_HOME=`pwd | sed 's/\(.*\/ponni\).*/\1/'`
export KOKKOS_HOME=$PONNI_HOME/unit/externals/kokkos

export CRAYPE_LINK_TYPE=dynamic

export CC=cc
export CXX=CC
export FC=ftn

unset CXXFLAGS
unset FFLAGS
unset FCFLAGS

export PONNI_DEBUG=ON
export PONNI_CXX_FLAGS="-O0 -g -DYAKL_AUTO_FENCE -DYAKL_AUTO_PROFILE"
export PONNI_LINK_FLAGS=""
export PONNI_F90_FLAGS="-O0 -g"
export PONNI_BACKEND=Kokkos_ENABLE_HIP
export PONNI_ARCH=Kokkos_ARCH_AMD_GFX90A
