#!/bin/bash

$MODULESHOME/init/bash
module reset
module load PrgEnv-amd cray-hdf5




PONNI_HOME=`pwd | sed 's/\(.*\/ponni\).*/\1/'`
export KOKKOS_HOME=$PONNI_HOME/unit/externals/kokkos

export CRAYPE_LINK_TYPE=dynamic

export CC=cc
export CXX=CC
export FC=ftn

unset CXXFLAGS
unset FFLAGS
unset FCFLAGS

export PONNI_DEBUG=ON
export PONNI_CXX_FLAGS="-O0 -g"
export PONNI_LINK_FLAGS=""
export PONNI_BACKEND=""
export PONNI_ARCH=""
export PONNI_COVERAGE=OFF
