#!/bin/bash

$MODULESHOME/init/bash
module reset
module load PrgEnv-amd craype-accel-amd-gfx90a

export ROCM_PATH=${CRAY_AMD_COMPILER_PREFIX}
unset HSA_XNACK

PONNI_HOME=`pwd | sed 's/\(.*\/ponni\).*/\1/'`
export KOKKOS_HOME=$PONNI_HOME/unit/externals/kokkos

export CRAYPE_LINK_TYPE=dynamic

export CC=cc
export CXX=CC
export FC=ftn

unset CXXFLAGS
unset FFLAGS
unset FCFLAGS

export PONNI_DEBUG=OFF
export PONNI_CXX_FLAGS="-O3;-ffast-math;-munsafe-fp-atomics;-I${ROCM_PATH}/include;-D__HIP_ROCclr__;-D__HIP_ARCH_GFX90A__=1;--rocm-path=${ROCM_PATH};--offload-arch=gfx90a;-Wno-unused-result;-Wno-macro-redefined"
export PONNI_LINK_FLAGS="--rocm-path=${ROCM_PATH};-L${ROCM_PATH}/lib;-lamdhip64"
export PONNI_BACKEND=Kokkos_ENABLE_HIP
export PONNI_ARCH=Kokkos_ARCH_AMD_GFX90A
export PONNI_COVERAGE=OFF
